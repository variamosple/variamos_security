{
  "name": "@variamosple/variamos-security",
  "private": false,
  "version": "0.1.0",
  "description": "VariaMos security commons for node",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-package": "node scripts/check-package.mjs && publint --strict",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check --error-on-warnings . && node scripts/check-suppressions.mjs",
    "format": "biome format --write .",
    "find-deadcode": "knip",
    "test": "vitest run",
    "prepack": "npm run build",
    "spell": "cspell --no-progress --dot --gitignore \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,jsonc,css,md,yml,yaml,sh}\"",
    "prepare": "husky"
  },
  "keywords": [
    "VariaMos",
    "Security"
  ],
  "author": "variamosple",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.6",
    "cspell": "^10.5.0",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
