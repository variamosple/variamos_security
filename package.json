{
  "name": "@variamosple/variamos-security",
  "private": false,
  "version": "0.1.0",
  "description": "VariaMos security commons for node",
  "main": "./dist/index.js",
  "module": "./dist/",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-package": "node scripts/check-package.mjs && publint --strict",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check --error-on-warnings . && node scripts/check-suppressions.mjs",
    "format": "biome format --write .",
    "find-deadcode": "knip",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "VariaMos",
    "Security"
  ],
  "author": "variamosple",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.2",
    "knip": "^6.45.1",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
